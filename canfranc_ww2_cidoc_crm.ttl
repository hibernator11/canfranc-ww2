# ---------- PLACES (E53) ----------

ex:CanfrancStation a crm:E53_Place ;
    crm:P1_is_identified_by ex:CanfrancStationName ;
    crm:P3_has_note "Estación Internacional de Canfranc; nodo ferroviario y aduanero transpirenaico." .

ex:SomportRailTunnel a crm:E53_Place ;
    crm:P1_is_identified_by ex:SomportTunnelName ;
    crm:P3_has_note "Túnel ferroviario de Somport, conexión Canfranc-Pau y espacio fronterizo." .

ex:CanfrancLosAranones a crm:E53_Place ;
    crm:P1_is_identified_by ex:CanfrancLosAranonesName ;
    crm:P3_has_note "Entorno urbano y ferroviario de Canfranc-Los Arañones." .

ex:CollDeLadronesFort a crm:E53_Place ;
    crm:P1_is_identified_by ex:CollDeLadronesName ;
    crm:P3_has_note "Fuerte de Coll de Ladrones, infraestructura militar del valle de Canfranc." .

ex:Zaragoza a crm:E53_Place ;
    crm:P1_is_identified_by ex:ZaragozaName .

ex:SanSebastian a crm:E53_Place ;
    crm:P1_is_identified_by ex:SanSebastianName .

ex:FranceOccupied a crm:E53_Place ;
    crm:P1_is_identified_by ex:FranceOccupiedName ;
    crm:P3_has_note "Francia bajo ocupación alemana durante el periodo relevante." .

ex:Spain a crm:E53_Place ;
    crm:P1_is_identified_by ex:SpainName .

ex:Portugal a crm:E53_Place ;
    crm:P1_is_identified_by ex:PortugalName .

ex:Switzerland a crm:E53_Place ;
    crm:P1_is_identified_by ex:SwitzerlandName .

ex:Algiers a crm:E53_Place ;
    crm:P1_is_identified_by ex:AlgiersName .

