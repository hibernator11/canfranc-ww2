# ---------- PEOPLE / GROUPS ----------

ex:AlbertLeLay a crm:E21_Person ;
    crm:P1_is_identified_by ex:AlbertLeLayName ;
    crm:P3_has_note "Funcionario francés de aduanas destinado en Canfranc en 1940; posteriormente vinculado a redes de evasión e inteligencia aliadas." .

ex:AndreManuel a crm:E21_Person ;
    crm:P1_is_identified_by ex:AndreManuelName ;
    crm:P3_has_note "Relacionado con la dirección de la red Mithridate según la investigación periodística citada." .

ex:ColonelRemy a crm:E21_Person ;
    crm:P1_is_identified_by ex:ColonelRemyName ;
    crm:P3_has_note "Dirigente de la Resistencia francesa relacionado con el reclutamiento/contacto de Le Lay según la fuente periodística citada." .

ex:DoctorRochas a crm:E21_Person ;
    crm:P1_is_identified_by ex:DoctorRochasName ;
    crm:P3_has_note "Relacionado con la red Pie según la investigación periodística citada." .

ex:LolaPardo a crm:E21_Person ;
    crm:P1_is_identified_by ex:LolaPardoName ;
    crm:P3_has_note "Colaboradora/correo que, según su testimonio recogido por HERALDO, transportó información desde Canfranc hacia Zaragoza." .

ex:SantiagoMarraco a crm:E21_Person ;
    crm:P1_is_identified_by ex:SantiagoMarracoName ;
    crm:P3_has_note "Testimonio local utilizado para documentar movimientos de militares alemanes por el túnel de Somport al final de la guerra." .

ex:FrenchResistance a crm:E74_Group ;
    crm:P1_is_identified_by ex:FrenchResistanceName .

ex:AlliedIntelligenceNetworks a crm:E74_Group ;
    crm:P1_is_identified_by ex:AlliedIntelligenceNetworksName ;
    crm:P3_has_note "Agrupación conceptual para las redes aliadas relacionadas con Canfranc; no debe interpretarse como una única organización histórica." .

ex:GermanMilitary a crm:E74_Group ;
    crm:P1_is_identified_by ex:GermanMilitaryName .

ex:AlbertLeLayName a crm:E41_Appellation ; crm:P190_has_symbolic_content "Albert Le Lay" .
ex:AndreManuelName a crm:E41_Appellation ; crm:P190_has_symbolic_content "André Manuel" .
ex:ColonelRemyName a crm:E41_Appellation ; crm:P190_has_symbolic_content "Coronel Rémy" .
ex:DoctorRochasName a crm:E41_Appellation ; crm:P190_has_symbolic_content "Doctor Rochas" .
ex:LolaPardoName a crm:E41_Appellation ; crm:P190_has_symbolic_content "Lola Pardo" .
ex:SantiagoMarracoName a crm:E41_Appellation ; crm:P190_has_symbolic_content "Santiago Marraco" .
ex:FrenchResistanceName a crm:E41_Appellation ; crm:P190_has_symbolic_content "Resistencia francesa" .
ex:AlliedIntelligenceNetworksName a crm:E41_Appellation ; crm:P190_has_symbolic_content "Redes de inteligencia aliadas vinculadas a Canfranc" .
ex:GermanMilitaryName a crm:E41_Appellation ; crm:P190_has_symbolic_content "Militares alemanes" .

# ---------- MATERIALS / OBJECTS ----------

ex:GoldShipments a crm:E19_Physical_Object ;
    crm:P1_is_identified_by ex:GoldShipmentsName ;
    crm:P3_has_note "Envíos de oro documentados en la documentación aduanera conocida como 'Documentos de Canfranc'." .

ex:WolframiumShipments a crm:E19_Physical_Object ;
    crm:P1_is_identified_by ex:WolframiumShipmentsName ;
    crm:P3_has_note "Envíos de wolframio y otras materias primas estratégicas asociados al comercio de guerra hispano-alemán." .

ex:CanfrancDocuments a crm:E31_Document ;
    crm:P1_is_identified_by ex:CanfrancDocumentsName ;
    crm:P3_has_note "Conjunto de documentos aduaneros descubiertos en la estación en 2000 y utilizados para reconstruir movimientos de oro entre 1942 y 1943." .

ex:GoldShipmentsName a crm:E41_Appellation ; crm:P190_has_symbolic_content "Envíos de oro documentados en Canfranc" .
ex:WolframiumShipmentsName a crm:E41_Appellation ; crm:P190_has_symbolic_content "Envíos de wolframio" .
ex:CanfrancDocumentsName a crm:E41_Appellation ; crm:P190_has_symbolic_content "Documentos de Canfranc" .

# ---------- TIME-SPANS (E52) ----------

ex:TS_1939 a crm:E52_Time-Span ;
    crm:P81_ongoing_throughout "1939" .

ex:TS_1940 a crm:E52_Time-Span ;
    crm:P81_ongoing_throughout "1940" .

ex:TS_1941_1944 a crm:E52_Time-Span ;
    crm:P81_ongoing_throughout "1941-1944" .

ex:TS_April1942 a crm:E52_Time-Span ;
    crm:P82_at_some_time_within "1942-04" .

ex:TS_June1942_December1943 a crm:E52_Time-Span ;
    crm:P81_ongoing_throughout "1942-06/1943-12" .

ex:TS_1943 a crm:E52_Time-Span ;
    crm:P81_ongoing_throughout "1943" .

ex:TS_1944 a crm:E52_Time-Span ;
    crm:P81_ongoing_throughout "1944" .

# ---------- EVENTS / ACTIVITIES ----------

ex:RefugeeMovements1939 a crm:E9_Move ;
    crm:P1_is_identified_by ex:RefugeeMovements1939Name ;
    crm:P7_took_place_at ex:CanfrancStation ;
    crm:P27_moved_from ex:FranceOccupied ;
    crm:P26_moved_to ex:Spain ;
    crm:P4_has_time-span ex:TS_1939 ;
    crm:P3_has_note "Movimientos de población y refugiados relacionados con la frontera franco-española tras la Guerra Civil y en el contexto de 1939." ;
    crm:P67_refers_to ex:CanfrancMunicipalHistory .

ex:AlbertLeLayArrival a crm:E5_Event ;
    crm:P1_is_identified_by ex:AlbertLeLayArrivalName ;
    crm:P7_took_place_at ex:CanfrancStation ;
    crm:P11_had_participant ex:AlbertLeLay ;
    crm:P4_has_time-span ex:TS_1940 ;
    crm:P3_has_note "Llegada/destino de Albert Le Lay como responsable de la aduana francesa de Canfranc." ;
    crm:P67_refers_to ex:LeLayMemorial, ex:FrenchCustomsHistory .

ex:AlliedIntelligenceActivity a crm:E7_Activity ;
    crm:P1_is_identified_by ex:AlliedIntelligenceActivityName ;
    crm:P7_took_place_at ex:CanfrancStation, ex:Zaragoza, ex:SanSebastian ;
    crm:P14_carried_out_by ex:AlbertLeLay, ex:FrenchResistance, ex:AlliedIntelligenceNetworks ;
    crm:P4_has_time-span ex:TS_1941_1944 ;
    crm:P3_has_note "Actividades de evasión, transporte de información y enlace con redes de resistencia e inteligencia aliadas." ;
    crm:P67_refers_to ex:HeraldoEspionageArticle, ex:FrenchCustomsHistory .

ex:RefugeeEscapeNetwork a crm:E7_Activity ;
    crm:P1_is_identified_by ex:RefugeeEscapeNetworkName ;
    crm:P7_took_place_at ex:CanfrancStation, ex:SomportRailTunnel ;
    crm:P14_carried_out_by ex:AlbertLeLay, ex:FrenchResistance ;
    crm:P4_has_time-span ex:TS_1941_1944 ;
    crm:P3_has_note "Ayuda al paso hacia España de refugiados, resistentes, aviadores aliados y familias judías según las fuentes citadas." ;
    crm:P67_refers_to ex:FrenchCustomsHistory, ex:HeraldoEspionageArticle .

ex:NetworkArrestsApril1942 a crm:E5_Event ;
    crm:P1_is_identified_by ex:NetworkArrestsApril1942Name ;
    crm:P7_took_place_at ex:CanfrancStation, ex:Zaragoza ;
    crm:P4_has_time-span ex:TS_April1942 ;
    crm:P11_had_participant ex:FrenchResistance, ex:AlliedIntelligenceNetworks ;
    crm:P3_has_note "Detención de integrantes de redes de inteligencia; la fuente periodística consultada cifra en 30 los participantes detenidos en abril de 1942." ;
    crm:P67_refers_to ex:HeraldoEspionageArticle, ex:ElPaisCanfrancArticle .

ex:GoldTransport1942_1943 a crm:E9_Move ;
    crm:P1_is_identified_by ex:GoldTransport1942_1943Name ;
    crm:P7_took_place_at ex:CanfrancStation ;
    crm:P25_moved ex:GoldShipments ;
    crm:P27_moved_from ex:Switzerland ;
    crm:P26_moved_to ex:Portugal, ex:Spain ;
    crm:P4_has_time-span ex:TS_June1942_December1943 ;
    crm:P3_has_note "Movimientos de oro documentados en la estación. Las fuentes citadas reconstruyen aproximadamente 86,6 toneladas: 74,5 t hacia Portugal y 12,1 t hacia España." ;
    crm:P67_refers_to ex:CanfrancDocuments, ex:IFC_GoldCanfranc, ex:HeraldoGoldArticle .

ex:WolframiumTradeActivity a crm:E7_Activity ;
    crm:P1_is_identified_by ex:WolframiumTradeActivityName ;
    crm:P7_took_place_at ex:CanfrancStation ;
    crm:P14_carried_out_by ex:GermanMilitary ;
    crm:P16_used_specific_object ex:WolframiumShipments ;
    crm:P4_has_time-span ex:TS_June1942_December1943 ;
    crm:P3_has_note "Actividad comercial/logística vinculada al suministro de materias primas estratégicas, incluido wolframio, en el contexto del comercio con Alemania." ;
    crm:P67_refers_to ex:IFC_GoldCanfranc, ex:HeraldoGoldArticle .

ex:GermanPresenceCanfranc a crm:E5_Event ;
    crm:P1_is_identified_by ex:GermanPresenceCanfrancName ;
    crm:P7_took_place_at ex:CanfrancStation, ex:CanfrancLosAranones ;
    crm:P11_had_participant ex:GermanMilitary ;
    crm:P4_has_time-span ex:TS_1941_1944 ;
    crm:P3_has_note "Presencia y vigilancia alemana asociada al sector internacional/fronterizo de la estación. No debe modelarse como una invasión alemana de España." ;
    crm:P67_refers_to ex:CanfrancHistoryArticle, ex:HeraldoGoldArticle .

ex:AlbertLeLayDiscoveryEscape a crm:E5_Event ;
    crm:P1_is_identified_by ex:AlbertLeLayDiscoveryEscapeName ;
    crm:P7_took_place_at ex:CanfrancStation ;
    crm:P11_had_participant ex:AlbertLeLay ;
    crm:P4_has_time-span ex:TS_1943 ;
    crm:P3_has_note "Descubrimiento de la actividad de Le Lay y huida posterior hacia Argel según las fuentes municipal, aduanera y periodística." ;
    crm:P67_refers_to ex:LeLayMemorial, ex:FrenchCustomsHistory, ex:HeraldoEspionageArticle .

ex:LeLayEscapeMove a crm:E9_Move ;
    crm:P1_is_identified_by ex:LeLayEscapeMoveName ;
    crm:P25_moved ex:AlbertLeLay ;
    crm:P27_moved_from ex:CanfrancStation ;
    crm:P26_moved_to ex:Algiers ;
    crm:P4_has_time-span ex:TS_1943 ;
    crm:P3_has_note "Desplazamiento de huida de Le Lay desde Canfranc hacia Argel tras ser descubierto." ;
    crm:P67_refers_to ex:LeLayMemorial, ex:FrenchCustomsHistory .

ex:GermanRetreatThroughSomport a crm:E9_Move ;
    crm:P1_is_identified_by ex:GermanRetreatThroughSomportName ;
    crm:P7_took_place_at ex:SomportRailTunnel, ex:CanfrancStation ;
    crm:P25_moved ex:GermanMilitary ;
    crm:P27_moved_from ex:FranceOccupied ;
    crm:P26_moved_to ex:Spain ;
    crm:P4_has_time-span ex:TS_1944 ;
    crm:P3_has_note "Movimientos de militares alemanes en retirada que atravesaron a pie el túnel de Somport hacia España, según el testimonio local citado." ;
    crm:P67_refers_to ex:CanfrancHistoryArticle .

